# --- Ollama ---------------------------------------------------------------
# Basis-URL der Ollama-Instanz. Aus einem Container heraus zeigt
# host.docker.internal (bzw. die Host-IP) auf den Host, auf dem Ollama laeuft.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: eigene Ollama-Instanz je Pipeline-Stage, um die beiden V100 zu
# trennen. Leer lassen => OLLAMA_BASE_URL wird verwendet.
# Auf dem Host z. B.:
#   CUDA_VISIBLE_DEVICES=0 OLLAMA_HOST=127.0.0.1:11434 ollama serve
#   CUDA_VISIBLE_DEVICES=1 OLLAMA_HOST=127.0.0.1:11435 ollama serve
OLLAMA_BASE_URL_TEXT=
OLLAMA_BASE_URL_VISION=

# --- Pfade ----------------------------------------------------------------
DATA_DIR=/data
DATABASE_URL=

# --- Pipeline -------------------------------------------------------------
# Gleichzeitige Inserate je Stage (pro Ollama-Instanz)
TEXT_CONCURRENCY=2
VISION_CONCURRENCY=2
# Hoechstzahl Bilder, die je Inserat analysiert werden
MAX_IMAGES_PER_LISTING=8
# Hoeflichkeits-Pause zwischen zwei Requests an dieselbe Seite (Sekunden)
SCRAPE_DELAY_SECONDS=2.5
# Zeitzone fuer den Cron-Scheduler
SCHEDULER_TIMEZONE=Europe/Berlin

# --- CORS (nur im Dev-Modus noetig) --------------------------------------
CORS_ORIGINS=http://localhost:5173
